# Copia este archivo como .env y llena tus datos. El .env NUNCA se sube a GitHub.
HOST=localhost
PORT=3060
API_URL=/api/v1

# --- Alpaca (Paper Trading) ---
# https://app.alpaca.markets/paper/dashboard/overview -> API Keys -> Generate New Keys
ALPACA_KEY_ID=<tu-key-id>
ALPACA_SECRET_KEY=<tu-secret-key>
ALPACA_TRADING_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
# indicative = gratis (15 min de retraso) | opra = tiempo real (suscripción)
ALPACA_OPTIONS_FEED=indicative
ALPACA_STOCKS_FEED=iex

# --- Supabase (proyecto quant-core-engine-f0) ---
# Project Settings -> API Keys -> Secret key (sb_secret_...). Solo en el servidor.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SECRET_KEY=<sb_secret_...>
