    {
      "_id": "req_013",
      "_type": "request",
      "parentId": "fld_2_option_chains",
      "name": "POST seguir SPY (calls 3 semanas)",
      "description": "Ajusta las fechas si ya pasaron.",
      "method": "POST",
      "url": "{{ _.base_url }}/option-chains",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"underlying\": \"SPY\",\n  \"expiration_from\": \"2026-10-18\",\n  \"expiration_to\": \"2026-11-07\",\n  \"option_type\": \"call\"\n}"
      },
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        }
      ],
      "afterResponseScript": "const body = insomnia.response.json();\nif (body && body.id) insomnia.environment.set('chain_id', body.id);\nconst calls = (body.quotes || []).filter(q => q.type === 'call' && q.expiration === (body.quotes[0] || {}).expiration).sort((a, b) => a.strike - b.strike);\nconst i = Math.max(0, calls.findIndex(q => q.strike >= (body.underlyingPrice || 0)));\nif (calls[i]) insomnia.environment.set('leg_buy', calls[i].symbol);\nif (calls[i + 2]) insomnia.environment.set('leg_sell', calls[i + 2].symbol);",
      "metaSortKey": 13
    },
