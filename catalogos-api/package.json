    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongoose": "^9.10.0",
    "morgan": "^1.12.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.5",
    "@babel/core": "^8.0.5",
    "@babel/node": "^8.0.5",
    "@babel/plugin-transform-runtime": "^8.0.1",
    "@babel/preset-env": "^8.0.5",
    "nodemon": "^3.1.14"
