# Copia este archivo como .env y llena tus datos. El .env NO se sube a GitHub.
HOST=localhost
PORT=3020
API_URL=/api/v1

# Connection string de MongoDB Atlas (Database > Connect > Drivers > Node.js)
# Sustituye <usuario>, <password> y <cluster>. Para Mongo local usa: mongodb://localhost:27018
CONNECTION_STRING=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?appName=<AppName>
DATABASE=CatalogosDB
