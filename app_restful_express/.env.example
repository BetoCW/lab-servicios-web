# ---------------------------------------------------------------
# T1-Actividad 3 - app_restful_express
# Copia este archivo como .env y llena tus datos.
# El .env NUNCA se sube a GitHub (ya esta en .gitignore).
# ---------------------------------------------------------------

# --- Servidor ---
HOST=localhost
PORT=3050
API_URL=/api/v1

# --- Base de datos NoSQL: MongoDB Atlas ---
# Atlas > Database > Connect > Drivers > Node.js
# Para Mongo local con Docker usa: mongodb://localhost:27018
CONNECTION_STRING=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?appName=<AppName>
DATABASE=db_eeducation
COLLECTION=cat_institutos
DB_USER=<usuario>
DB_PASSWORD=<password>
