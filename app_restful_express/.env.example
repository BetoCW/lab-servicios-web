# ---------------------------------------------------------------
# T1-Actividad 3 - app_restful_express
# Copia este archivo como .env y llena tus datos.
# El .env NUNCA se sube a GitHub (ya esta en .gitignore).
# ---------------------------------------------------------------

# --- Servidor ---
HOST=localhost
PORT=3050
API_URL=/api/v1

# --- Base de datos NoSQL: MongoDB Atlas ---
# Atlas > Database > Connect > Drivers > Node.js
# Para Mongo local con Docker usa: mongodb://localhost:27018
CONNECTION_STRING=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?appName=<AppName>
DATABASE=db_eeducation
COLLECTION=cat_institutos
DB_USER=<usuario>
DB_PASSWORD=<password>

# --- T2-Actividad 2: Catalogo de Catalogos (proyecto final) ---
# Coleccion de MongoDB con los catalogos y sus valores embebidos
CATALOGS_COLLECTION=catalogs

# --- Base de datos SQL: Supabase (PostgreSQL) ---
# Supabase > Project Settings > Database > Connection string > URI
# Ejemplo Supabase: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Postgres local con Docker: postgres://lab:lab_local_2026@localhost:5433/eeducation
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@<host>:6543/postgres
SUPABASE_DB_SSL=true

# --- Sesion (JSON Web Token) ---
# Palabra secreta para firmar el token que guarda la base elegida al iniciar sesion
JWT_SECRET=<cadena-larga-y-aleatoria>
JWT_EXPIRES_IN=8h
